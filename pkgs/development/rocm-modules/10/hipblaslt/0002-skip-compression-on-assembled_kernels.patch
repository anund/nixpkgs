From 20b4efe36735c995192530f63e78f5b941d54800 Mon Sep 17 00:00:00 2001
From: Anund <anundm@gmail.com>
Date: Mon, 9 Nov 2026 00:00:35 +1100
Subject: [PATCH 2/5] skip compression on assembled_kernels

---
 .../tensilelite/Tensile/TensileCreateLibrary/Run.py | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/projects/hipblaslt/tensilelite/Tensile/TensileCreateLibrary/Run.py b/projects/hipblaslt/tensilelite/Tensile/TensileCreateLibrary/Run.py
index 367ff02f40a..9c4cae1bf3d 100644
--- a/projects/hipblaslt/tensilelite/Tensile/TensileCreateLibrary/Run.py
+++ b/projects/hipblaslt/tensilelite/Tensile/TensileCreateLibrary/Run.py
@@ -665,14 +665,17 @@ def writeSolutionsAndKernelsTCL(
     outOptions = rocisa.rocIsa.getInstance().getOutputOptions()
     outOptions.outputNoComment = not disableAsmComments
 
-    memcompress = len(uniqueAsmKernels) > 10000
+    # The composed worker returns only a small KernelMinResult, so the kernel
+    # source never leaves the worker process and doesn't need compressing for
+    # transport (unlike writeSolutionsAndKernels, which keeps sources in the
+    # parent between codegen and assembly).
     unaryProcessKernelSource = functools.partial(
         processKernelSource,
         kernelWriterAssembly,
         rocisa.rocIsa.getInstance().getData(),
         outOptions,
         splitGSU,
-        compress = memcompress,
+        compress = False,
     )
 
     unaryWriteAssembly = functools.partial(writeAssembly, assemblyTmpPath)
@@ -681,7 +684,11 @@ def writeSolutionsAndKernelsTCL(
             processed_kernel = unaryProcessKernelSource(kernel)
             written_kernel = unaryWriteAssembly(processed_kernel)
             assembled_kernel = assemble(written_kernel)
-            return processed_kernel
+            # Return only the small KernelMinResult (err/cuoccupancy/pgr/mathclk).
+            # The full source string is freed in the worker instead of being
+            # pickled back and retained.
+            # Consumer (passPostKernelInfoToLibrary) only needs the small fields.
+            return assembled_kernel
         return composed_function
 
     results = ParallelMap2(
-- 

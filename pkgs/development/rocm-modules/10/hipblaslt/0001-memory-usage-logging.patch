 from .ParseArguments import parseArguments
 
 
+def getMemoryUsage():
+    """Get peak and current memory usage in MB.
+
+    Peak comes from getrusage(RUSAGE_SELF).Current RSS comes from
+    /proc/self/status (Linux only); falls back to the peak value when
+    unavailable.
+    """
+    peak_memory_mb = 0.0
+    if resource is not None:
+        peak_memory_mb = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024
+
+    current_memory_mb = None
+    try:
+        with open('/proc/self/status') as f:
+            for line in f:
+                if line.startswith('VmRSS:'):
+                    current_memory_mb = int(line.split()[1]) / 1024
+                    break
+    except (OSError, ValueError):
+        pass
+    if current_memory_mb is None:
+        current_memory_mb = peak_memory_mb
+
+    return (peak_memory_mb, current_memory_mb)
+
+
+def logMemoryUsage(phase: str):
+    """Log current/peak RSS after a build phase to track where memory grows."""
+    peak_memory_mb, current_memory_mb = getMemoryUsage()
+    print(f"Memory after {phase}: current={current_memory_mb:,.1f} MB, peak={peak_memory_mb:,.1f} MB")
+
+
